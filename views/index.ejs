<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link
      rel="stylesheet"
      href="styles.css
    "
    />
  </head>
  <body>
    <%- include('header.ejs') %>

    <section class="messages">
      <% messages.forEach(m =>{ %>

        <div class="card">
          <div class="head">
            <h2 > <%= m.title %> </h2>
           <p > <%= m.author %> </p>
           
          </div>
          <p><%= m.message %></p>
        </div>



        <% }) %>
    </section>
  </body>
</html>
